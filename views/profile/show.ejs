<div class="max-w-2xl mx-auto space-y-6">
  <div class="bg-white dark:bg-slate-900 rounded-xl shadow p-6">
    <h1 class="text-2xl font-bold mb-1">My profile</h1>
    <p class="text-xs text-slate-500 mb-4">Member since <%= user.createdAt.toDateString() %></p>

    <form method="POST" action="/profile?_method=PUT" enctype="multipart/form-data" class="space-y-4">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <div class="flex items-center gap-4">
        <img src="<%= user.avatar?.url || 'https://api.dicebear.com/7.x/initials/svg?seed=' + encodeURIComponent(user.name) %>"
          class="w-20 h-20 rounded-full border" alt="avatar" />
        <input type="file" name="avatar" accept="image/*" class="text-sm" />
      </div>
      <input name="name" value="<%= user.name %>" class="w-full px-3 py-2 rounded-md border bg-transparent" />
      <button class="px-4 py-2 rounded-md bg-indigo-600 text-white">Save</button>
    </form>
  </div>

  <div class="bg-white dark:bg-slate-900 rounded-xl shadow p-6">
    <h2 class="text-lg font-semibold mb-3">Change password</h2>
    <form method="POST" action="/profile/password?_method=PUT" class="space-y-3">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <input name="current" type="password" placeholder="Current password" required class="w-full px-3 py-2 rounded-md border bg-transparent" />
      <input name="next" type="password" placeholder="New password (min 8)" minlength="8" required class="w-full px-3 py-2 rounded-md border bg-transparent" />
      <button class="px-4 py-2 rounded-md bg-indigo-600 text-white">Update password</button>
    </form>
  </div>
</div>

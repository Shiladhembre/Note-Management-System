<div class="max-w-md mx-auto bg-white dark:bg-slate-900 rounded-xl shadow p-8 mt-10">
  <h1 class="text-2xl font-bold mb-4">Forgot password</h1>
  <form method="POST" action="/auth/forgot" class="space-y-4">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <input name="email" type="email" placeholder="Your email" required class="w-full px-3 py-2 rounded-md border border-slate-300 dark:border-slate-700 bg-transparent" />
    <button class="w-full bg-indigo-600 hover:bg-indigo-700 text-white py-2 rounded-md">Send reset link</button>
  </form>
</div>

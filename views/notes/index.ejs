<div class="flex">
  <%- include('../partials/sidebar') %>
  <section class="flex-1 min-w-0">
    <div class="flex flex-wrap items-center gap-3 mb-4">
      <h1 class="text-2xl font-bold capitalize"><%= filter %> notes</h1>
      <form method="GET" action="/notes" class="flex-1 flex gap-2 max-w-xl ml-auto">
        <input type="hidden" name="filter" value="<%= filter %>" />
        <input name="q" value="<%= q %>" placeholder="Search…"
          class="flex-1 px-3 py-2 rounded-md border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900" />
        <select name="sort" class="px-3 py-2 rounded-md border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900">
          <option value="newest" <%= sort==='newest'?'selected':'' %>>Newest</option>
          <option value="oldest" <%= sort==='oldest'?'selected':'' %>>Oldest</option>
          <option value="updated" <%= sort==='updated'?'selected':'' %>>Updated</option>
        </select>
        <button class="px-3 py-2 rounded-md bg-indigo-600 text-white">Go</button>
      </form>
    </div>

    <% if (!notes.length) { %>
      <div class="text-center py-20 text-slate-500">
        <div class="text-5xl mb-3">🗒️</div>
        <p>No notes yet.</p>
        <a href="/notes/new" class="inline-block mt-4 px-4 py-2 bg-indigo-600 text-white rounded-md">Create your first note</a>
      </div>
    <% } else { %>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        <% notes.forEach(n => { %>
          <article class="rounded-xl shadow-sm border border-slate-200 dark:border-slate-800 p-4 transition hover:shadow-md"
            style="background-color: <%= n.color || '#ffffff' %>; color: #111;">
            <div class="flex items-start justify-between gap-2">
              <h3 class="font-semibold truncate"><%= n.title %></h3>
              <div class="flex gap-1 text-sm">
                <% if (n.pinned) { %><span title="Pinned">📌</span><% } %>
                <% if (n.favorite) { %><span title="Favorite">⭐</span><% } %>
              </div>
            </div>
            <p class="text-sm mt-2 line-clamp-4 whitespace-pre-wrap"><%= n.content %></p>
            <div class="flex flex-wrap gap-1 mt-3">
              <% (n.labels||[]).forEach(l => { %>
                <span class="text-xs px-2 py-0.5 bg-black/10 rounded">#<%= l %></span>
              <% }); %>
            </div>
            <div class="flex flex-wrap gap-1 mt-3 text-xs">
              <% if (filter !== 'trash') { %>
                <a href="/notes/<%= n._id %>/edit" class="px-2 py-1 bg-white/70 rounded hover:bg-white">Edit</a>
                <form method="POST" action="/notes/<%= n._id %>/pin" class="inline"><input type="hidden" name="_csrf" value="<%= csrfToken %>" /><button class="px-2 py-1 bg-white/70 rounded hover:bg-white"><%= n.pinned?'Unpin':'Pin' %></button></form>
                <form method="POST" action="/notes/<%= n._id %>/favorite" class="inline"><input type="hidden" name="_csrf" value="<%= csrfToken %>" /><button class="px-2 py-1 bg-white/70 rounded hover:bg-white"><%= n.favorite?'Unfav':'Fav' %></button></form>
                <form method="POST" action="/notes/<%= n._id %>/archive" class="inline"><input type="hidden" name="_csrf" value="<%= csrfToken %>" /><button class="px-2 py-1 bg-white/70 rounded hover:bg-white"><%= n.archived?'Unarchive':'Archive' %></button></form>
                <form method="POST" action="/notes/<%= n._id %>?_method=DELETE" class="inline" onsubmit="return confirm('Move to trash?')"><input type="hidden" name="_csrf" value="<%= csrfToken %>" /><button class="px-2 py-1 bg-rose-100 rounded hover:bg-rose-200">Trash</button></form>
                <a href="/notes/<%= n._id %>/export?format=pdf" class="px-2 py-1 bg-white/70 rounded hover:bg-white">PDF</a>
              <% } else { %>
                <form method="POST" action="/notes/<%= n._id %>/restore" class="inline"><input type="hidden" name="_csrf" value="<%= csrfToken %>" /><button class="px-2 py-1 bg-white/70 rounded">Restore</button></form>
                <form method="POST" action="/notes/<%= n._id %>/permanent?_method=DELETE" class="inline" onsubmit="return confirm('Delete forever?')"><input type="hidden" name="_csrf" value="<%= csrfToken %>" /><button class="px-2 py-1 bg-rose-200 rounded">Delete</button></form>
              <% } %>
            </div>
          </article>
        <% }); %>
      </div>

      <% if (pages > 1) { %>
        <div class="flex justify-center gap-2 mt-6">
          <% for (let p = 1; p <= pages; p++) { %>
            <a href="?page=<%= p %>&filter=<%= filter %>&sort=<%= sort %>&q=<%= q %>"
              class="px-3 py-1 rounded <%= p===page ? 'bg-indigo-600 text-white' : 'bg-slate-200 dark:bg-slate-800' %>"><%= p %></a>
          <% } %>
        </div>
      <% } %>
    <% } %>
  </section>
</div>
<script>
  // Realtime: refresh on note events for current user
  document.addEventListener('DOMContentLoaded', () => {
    if (typeof io === 'undefined') return;
    const socket = io();
    socket.emit('join', '<%= user._id %>');
    ['note:created','note:updated','note:trashed'].forEach(ev =>
      socket.on(ev, () => { /* simple refresh strategy */ }));
  });
</script>

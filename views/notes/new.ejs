<div class="max-w-2xl mx-auto bg-white dark:bg-slate-900 rounded-xl shadow p-6">
  <h1 class="text-2xl font-bold mb-4">New note</h1>
  <form method="POST" action="/notes" class="space-y-3">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <input name="title" placeholder="Title" required maxlength="200" class="w-full px-3 py-2 rounded-md border bg-transparent" />
    <textarea name="content" rows="10" placeholder="Markdown supported…" class="w-full px-3 py-2 rounded-md border bg-transparent"></textarea>
    <div class="flex flex-wrap gap-3 items-center">
      <label class="text-sm">Color <input type="color" name="color" value="#fff7c2" class="ml-2 align-middle" /></label>
      <input name="labels" placeholder="labels (comma separated)" class="flex-1 px-3 py-2 rounded-md border bg-transparent" />
    </div>
    <div class="flex gap-2 justify-end">
      <a href="/notes" class="px-4 py-2 rounded-md bg-slate-200 dark:bg-slate-800">Cancel</a>
      <button class="px-4 py-2 rounded-md bg-indigo-600 text-white">Save</button>
    </div>
  </form>
</div>

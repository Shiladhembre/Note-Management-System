<aside class="hidden md:block w-56 shrink-0 pr-4">
  <nav class="space-y-1 text-sm sticky top-20">
    <% const items = [
      ['/notes', 'All notes', '🗒'],
      ['/notes?filter=favorites', 'Favorites', '⭐'],
      ['/notes?filter=archived', 'Archived', '📦'],
      ['/notes?filter=trash', 'Trash', '🗑']
    ]; %>
    <% items.forEach(([href, label, icon]) => { %>
      <a href="<%= href %>" class="flex items-center gap-2 px-3 py-2 rounded-md hover:bg-slate-100 dark:hover:bg-slate-800">
        <span><%= icon %></span><span><%= label %></span>
      </a>
    <% }); %>
    <a href="/notes/new" class="mt-3 flex items-center justify-center gap-2 px-3 py-2 rounded-md bg-indigo-600 text-white hover:bg-indigo-700">+ New note</a>
    <% if (typeof allLabels !== 'undefined' && allLabels.length) { %>
      <div class="mt-4 text-xs uppercase tracking-wide text-slate-500 px-3">Labels</div>
      <% allLabels.forEach(l => { %>
        <a href="/notes?label=<%= l %>" class="block px-3 py-1.5 rounded-md hover:bg-slate-100 dark:hover:bg-slate-800">#<%= l %></a>
      <% }); %>
    <% } %>
  </nav>
</aside>

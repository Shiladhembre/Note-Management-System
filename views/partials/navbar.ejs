<nav class="bg-white dark:bg-slate-900 border-b border-slate-200 dark:border-slate-800 sticky top-0 z-30">
  <div class="max-w-7xl mx-auto px-4 h-14 flex items-center justify-between">
    <a href="/notes" class="font-bold text-lg flex items-center gap-2">
      <span class="inline-block w-7 h-7 bg-indigo-600 text-white rounded-md grid place-items-center">N</span>
      Smart Notes
    </a>
    <div class="flex items-center gap-3">
      <button @click="dark = !dark; localStorage.setItem('theme', dark ? 'dark' : 'light')"
        class="p-2 rounded-md hover:bg-slate-100 dark:hover:bg-slate-800" aria-label="Toggle theme">
        <span x-show="!dark">🌙</span><span x-show="dark">☀️</span>
      </button>
      <% if (user) { %>
        <a href="/profile" class="text-sm hover:underline"><%= user.name %></a>
        <form action="/auth/logout?_method=POST" method="POST" class="inline">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <button class="text-sm px-3 py-1.5 rounded-md bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700">Logout</button>
        </form>
      <% } else { %>
        <a href="/auth/login" class="text-sm hover:underline">Login</a>
        <a href="/auth/register" class="text-sm px-3 py-1.5 rounded-md bg-indigo-600 text-white hover:bg-indigo-700">Sign up</a>
      <% } %>
    </div>
  </div>
</nav>

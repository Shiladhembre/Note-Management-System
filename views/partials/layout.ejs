<!DOCTYPE html>
<html lang="en" x-data="{ dark: localStorage.getItem('theme') === 'dark' }" :class="dark ? 'dark' : ''">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof title !== 'undefined' ? title + ' • Smart Notes' : 'Smart Notes' %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>tailwind.config = { darkMode: 'class' }</script>
  <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.14.1/dist/cdn.min.js"></script>
  <script src="https://cdn.socket.io/4.7.5/socket.io.min.js" defer></script>
  <link rel="stylesheet" href="/css/styles.css" />
</head>
<body class="bg-slate-50 text-slate-800 dark:bg-slate-950 dark:text-slate-100 min-h-screen flex flex-col">
  <%- include('navbar') %>
  <%- include('flash') %>
  <main class="flex-1 w-full max-w-7xl mx-auto px-4 py-6"><%- body %></main>
  <footer class="text-center text-xs text-slate-500 py-6">© Smart Notes</footer>
  <script src="/js/app.js" defer></script>
</body>
</html>
